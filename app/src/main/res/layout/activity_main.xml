<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Camera preview -->
    <TextureView
        android:id="@+id/textureView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlsPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Controls panel -->
    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/controls_background"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Exposure Time row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_exposure"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvExposureValue"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="1 s" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBarExposure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:max="10"
            android:progress="5"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <!-- ISO row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_iso"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvIsoValue"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="ISO 100" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBarIso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:max="5"
            android:progress="0"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <!-- Frame Count row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_frame_count"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvFrameCountValue"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="16" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBarFrameCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:max="3"
            android:progress="2"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <!-- Status text -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"
            android:text="@string/status_ready" />

        <!-- Burst progress bar (hidden until a burst is active) -->
        <ProgressBar
            android:id="@+id/progressBurst"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:progressTint="@color/accent"
            android:visibility="gone" />

        <!-- Buttons row: single-shot capture + burst stack -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Single-shot JPEG capture -->
            <Button
                android:id="@+id/btnCapture"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/btn_capture"
                android:textSize="14sp"
                android:textColor="@color/on_accent"
                android:backgroundTint="@color/accent"
                android:stateListAnimator="@null" />

            <!-- RAW burst-stack capture -->
            <Button
                android:id="@+id/btnBurstStack"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/btn_burst_stack"
                android:textSize="14sp"
                android:textColor="@color/on_accent"
                android:backgroundTint="@color/accent"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
