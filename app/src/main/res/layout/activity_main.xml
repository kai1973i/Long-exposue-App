<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- ═══════════════════════════════════════════════════════
         Top Info Bar  (DSLR status strip)
         ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/topInfoBar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="@color/info_bar_background"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvInfoMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:text="M"
            android:paddingEnd="10dp" />

        <TextView
            android:id="@+id/tvInfoExposure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="1 s"
            android:paddingEnd="10dp" />

        <TextView
            android:id="@+id/tvInfoIso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="ISO 100"
            android:paddingEnd="10dp" />

        <TextView
            android:id="@+id/tvInfoAperture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="f/1.8"
            android:paddingEnd="10dp" />

        <TextView
            android:id="@+id/tvInfoWb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="AWB"
            android:paddingEnd="10dp" />

        <TextView
            android:id="@+id/tvInfoEv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="EV 0.0"
            android:gravity="end" />

        <!-- Grid toggle -->
        <Button
            android:id="@+id/btnToggleGrid"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="@string/btn_grid"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:background="@android:color/transparent"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginStart="4dp" />

        <!-- Histogram toggle -->
        <Button
            android:id="@+id/btnToggleHistogram"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="@string/btn_histogram"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:background="@android:color/transparent"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         Camera preview  +  overlays
         ═══════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topInfoBar"
        app:layout_constraintBottom_toTopOf="@id/controlsScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Rule-of-thirds grid (hidden by default) -->
        <com.longexposure.app.GridOverlayView
            android:id="@+id/gridOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Luminance histogram (top-right corner, hidden by default) -->
        <com.longexposure.app.HistogramView
            android:id="@+id/histogramView"
            android:layout_width="120dp"
            android:layout_height="70dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:visibility="gone" />

        <!-- Shutter curtain animation overlay -->
        <View
            android:id="@+id/shutterOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ═══════════════════════════════════════════════════════
         Controls panel  (scrollable)
         ═══════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/controlsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/controls_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/controlsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

            <!-- ── Shooting mode toggle ─────────────────────── -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroupMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeP"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="P"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:strokeColor="@color/accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeAv"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Av"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:strokeColor="@color/accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeTv"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tv"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:strokeColor="@color/accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeM"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="M"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:strokeColor="@color/accent" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- ── Exposure row ──────────────────────────────── -->
            <LinearLayout
                android:id="@+id/rowExposure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_exposure"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvExposureValue"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:text="1 s" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarExposure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:max="10"
                android:progress="5"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <!-- ── ISO row ───────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/rowIso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_iso"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvIsoValue"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:text="ISO 100" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarIso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:max="5"
                android:progress="0"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <!-- ── Aperture row (virtual) ────────────────────── -->
            <LinearLayout
                android:id="@+id/rowAperture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_aperture"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvApertureValue"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:text="f/1.8" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarAperture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:max="5"
                android:progress="0"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <!-- ── White Balance row ─────────────────────────── -->
            <LinearLayout
                android:id="@+id/rowWb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_white_balance"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerWb"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/accent" />
            </LinearLayout>

            <!-- ── Focus row ─────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/rowFocus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_focus"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvFocusValue"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:text="∞" />

                <Button
                    android:id="@+id/btnAf"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="@string/btn_af_off"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/controls_background"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarFocus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <!-- ── Self-Timer row ─────────────────────────────── -->
            <LinearLayout
                android:id="@+id/rowTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_self_timer"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerTimer"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/accent" />
            </LinearLayout>

            <!-- ── AEB Bracketing row ─────────────────────────── -->
            <LinearLayout
                android:id="@+id/rowBracketing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_bracketing"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerBracketing"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/accent" />
            </LinearLayout>

            <!-- ── Status text ───────────────────────────────── -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"
                android:text="@string/status_ready" />

            <!-- ── Capture button ─────────────────────────────── -->
            <Button
                android:id="@+id/btnCapture"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_capture"
                android:textSize="15sp"
                android:textColor="@color/on_accent"
                android:backgroundTint="@color/accent"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
